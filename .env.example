# ==========================================
# ELYRAPOS BACKEND CONFIGURATION
# ==========================================

# Application Port
PORT=3000

# Environment (development | production)
NODE_ENV=development

# Root Domain for Tenant Resolution
# Gunakan "elyrapos.my.id" untuk production
# Gunakan "localhost" untuk local testing
ROOT_DOMAIN=elyrapos.my.id

# ==========================================
# DATABASE & CACHE
# ==========================================

# Direct connection (Digunakan oleh Drizzle Kit & Public Schema)
DATABASE_URL=postgres://user:password@localhost:5432/pos_db

# Connection Pooler URL (Digunakan oleh Middleware & Tenant queries)
# Secara default diarahkan ke port PgBouncer (misal 6432)
PGBOUNCER_URL=postgres://user:password@localhost:6432/pos_db

# Redis Connection URL (Cache resolusi tenant)
REDIS_URL=redis://localhost:6379

# ==========================================
# SECURITY & AUTHENTICATION
# ==========================================

# Rahasia JWT
JWT_SECRET=your_super_secret_jwt_key_here

# DB URL Encryption Key (generate with: openssl rand -hex 32)
DB_URL_ENCRYPTION_KEY=

# Daftar domain yang diizinkan CORS (Pisahkan dengan koma)
# Jangan sertakan wildcard (*), tuliskan domain utuh atau root agar dicek secara dinamis
CORS_ALLOWED_DOMAINS=http://localhost:5173,https://elyrapos.my.id

# ==========================================
# QZ TRAY CODE SIGNING (PRINTING SECURITY)
# ==========================================
# (Opsional) Path ke file sertifikat publik & kunci privat RSA QZ Tray
# Jika dikosongkan, backend secara otomatis menggunakan auto-generated keypair sementara di memori
QZ_CERTIFICATE_PATH=/etc/elyra/certs/digital-certificate.txt
QZ_PRIVATE_KEY_PATH=/etc/elyra/certs/private-key.pem

# Atau isi langsung string PEM (direkomendasikan untuk Docker / Kubernetes / Secret Manager):
# QZ_CERTIFICATE="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# QZ_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

